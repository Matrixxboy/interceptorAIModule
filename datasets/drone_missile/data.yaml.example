# Example Ultralytics dataset config for drone / missile training.
# Copy to data.yaml and point paths at your images/labels.
#
# Capture raw frames:
#   python scripts/capture_lock_frames.py --camera 0 --every 5 --max 200
# Label (YOLO txt), then split into train/val folders.
#
# Directory layout:
#   datasets/drone_missile/
#     images/raw/   ...   (from capture helper)
#     images/train/ ...
#     images/val/   ...
#     labels/train/ ...   (YOLO txt: class cx cy w h — normalized)
#     labels/val/   ...
#     data.yaml
#
# Train mobile nano weights:
#   python scripts/train_drone_missile.py --base yolo11n.pt

path: .
train: images/train
val: images/val

names:
  0: drone
  1: missile
  2: aircraft
